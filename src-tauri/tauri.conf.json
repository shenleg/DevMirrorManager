{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Node.js Downloader",
  "version": "0.1.0",
  "identifier": "dev.nodejs-downloader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Node.js 发行版本", "width": 1050, "height": 780, "minWidth": 360, "minHeight": 480 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": false, "macOS": { "minimumSystemVersion": "13.0" } }
}
